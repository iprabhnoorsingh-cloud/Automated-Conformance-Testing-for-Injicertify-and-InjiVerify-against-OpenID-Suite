# General app settings (all use the MCC_ prefix)
MCC_APP_NAME=MOSIP Conformance Center
MCC_ENVIRONMENT=development
MCC_CORS_ORIGINS=http://localhost:3000

# OpenID Foundation Conformance Suite integration (Milestone 4).
# Point this at a local/staging conformance-suite instance you control —
# never at the public certification.openid.net environment by default.
# TODO: Securely load OPENID_CONFORMANCE_API_TOKEN from an environment
# variable or secrets vault in real deployments. Do not hardcode it.
OPENID_CONFORMANCE_BASE_URL=http://localhost:8443
OPENID_CONFORMANCE_API_TOKEN=
OPENID_CONFORMANCE_VERIFY_SSL=true
OPENID_CONFORMANCE_TIMEOUT=30
OPENID_CONFORMANCE_WAIT_TIMEOUT=60

# Opt-in only: set to 1 to enable tests/test_openid_integration.py against
# a REAL conformance-suite instance (skipped by default, never run in CI).
OPENID_CONFORMANCE_INTEGRATION=0
